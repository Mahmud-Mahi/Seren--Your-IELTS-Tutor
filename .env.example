# ---------------------------------------------------------------------------
# LLM Provider Configuration (cascading fallback: tried in priority order)
# All providers use the OpenAI-compatible chat completions API — no paid APIs.
# Copy this file to .env and adjust as needed. Every value is optional.
# ---------------------------------------------------------------------------

# Provider 1: Local LLM server (e.g. LM Studio, llama.cpp server, LiteLLM, vLLM)
LLM_BASE_URL=http://localhost:3456/v1
# 'auto' picks the best available model from /v1/models, or set an exact model id
LLM_MODEL=auto
LLM_API_KEY=none
#LLM_TIMEOUT_MS=120000

# Provider 2: Ollama (https://ollama.com — free, runs locally)
OLLAMA_BASE_URL=http://localhost:11434/v1
OLLAMA_MODEL=ornith:9b
#OLLAMA_TIMEOUT_MS=120000

# Provider 3: Groq Cloud free tier (https://console.groq.com — no credit card)
# Alternatively, save the key at runtime via the in-app Settings panel.
GROQ_API_KEY=
GROQ_MODEL=openai/gpt-oss-120b
#GROQ_TIMEOUT_MS=45000

# Priority order for the provider cascade (comma-separated)
PROVIDER_PRIORITY=local,ollama,groq

# Pin Seren to a single provider ('local', 'ollama', 'groq', or unset for auto)
#PINNED_PROVIDER=

# ---------------------------------------------------------------------------
# Speech-to-Text engines (Settings -> Speech-to-Text Engine)
# local = offline Sherpa-ONNX Whisper (default, always free, auto fallback)
# groq = Groq Cloud Whisper (reuses GROQ_API_KEY above)
# assemblyai = AssemblyAI cloud (needs ASSEMBLYAI_API_KEY)
# If a cloud key is missing/expired/out-of-credit, Seren falls back to local.
# ---------------------------------------------------------------------------
#STT_ENGINE=local
# Groq STT model: whisper-large-v3-turbo, whisper-large-v3, distil-whisper-large-v3-en
#GROQ_STT_MODEL=whisper-large-v3-turbo
#ASSEMBLYAI_API_KEY=
# AssemblyAI speech model: best, nano, slam-1
#ASSEMBLYAI_SPEECH_MODEL=best

# ---------------------------------------------------------------------------
# Neural TTS (Microsoft Edge Read Aloud voices — free, high quality)
# Voice can also be changed at runtime in the Settings panel.
# ---------------------------------------------------------------------------
TTS_ENABLED=true
TTS_VOICE=en-US-JennyNeural

# Server port
#PORT=3000
